#!/bin/bash
# Compatibility launcher for the Sentry skill.
# Prefer the modern Sentry CLI (`sentry`, https://cli.sentry.dev/) when it is
# installed. Fall back to the legacy sentry-cli wrapper for older workflows.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LEGACY_WRAPPER="$SCRIPT_DIR/sentry-cli-wrapper"
SUBCOMMAND="${1:-}"

# Force legacy behavior when needed:
#   SENTRY_SKILL_LEGACY=1 <skill-dir>/scripts/sentry issues list
if [[ "${SENTRY_SKILL_LEGACY:-}" == "1" ]]; then
  exec "$LEGACY_WRAPPER" "$@"
fi

# Backward compatibility for commands from the old skill docs / sentry-cli.
case "$SUBCOMMAND" in
  config|projects|issues)
    exec "$LEGACY_WRAPPER" "$@"
    ;;
esac

if command -v sentry >/dev/null 2>&1; then
  exec sentry "$@"
fi

if command -v sentry-cli >/dev/null 2>&1; then
  echo "Warning: modern 'sentry' CLI not found; falling back to legacy sentry-cli wrapper." >&2
  exec "$LEGACY_WRAPPER" "$@"
fi

echo "Error: neither 'sentry' nor 'sentry-cli' is installed." >&2
echo "Install modern Sentry CLI: brew install getsentry/tools/sentry" >&2
exit 127
