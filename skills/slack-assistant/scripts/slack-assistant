#!/usr/bin/env python3
"""Directory-scoped, draft-first SlackCLI entry point. Never prints credentials."""
import json
import os
from pathlib import Path
import sys

ORG_NAMES = ("wearedevs", "wollzelle")
ALLOWED = {
    ("conversations", "list"), ("conversations", "read"),
    ("conversations", "get"), ("conversations", "unread"),
    ("search", "messages"), ("search", "channels"), ("search", "people"),
    ("messages", "draft"), ("saved", "list"), ("team", "info"),
    ("canvas", "list"), ("canvas", "read"), ("files", "info"),
    ("files", "read"),
}
HELP = """Usage: slack-assistant [--workspace wearedevs|wollzelle] COMMAND ...
  bind ORGANIZATION PROFILE_KEY   Bind a directory to a logged-in Slack profile
  context                         Show locally bound organization and workspace
  team info --json                Verify live access to the selected workspace
  draft OPTIONS                   Create an unsent Slack draft
  send-approved OPTIONS           Send only after explicit user approval
  conversations list|read|get|unread OPTIONS
  search messages|channels|people OPTIONS
  messages draft OPTIONS
  saved list | canvas list|read | files info|read

Uses the calling directory under ~/Development/wearedevs or ~/Development/wollzelle.
Outside those roots, --workspace is required. Sending requires send-approved.
Login interactively with: slackcli auth login-auto
Find profile keys with: slackcli auth list
"""


def organization(cwd, home, explicit=None):
    if explicit:
        if explicit not in ORG_NAMES:
            raise ValueError("Workspace must be wearedevs or wollzelle.")
        return explicit
    cwd = cwd.resolve()
    for name in ORG_NAMES:
        root = (home / "Development" / name).resolve()
        if cwd == root or root in cwd.parents:
            return name
    raise ValueError("Outside workspace roots; specify --workspace wearedevs|wollzelle.")


def load_profiles(config_dir):
    credentials = config_dir / "workspaces.json"
    if not credentials.exists():
        raise ValueError("First run slackcli auth login-auto in your terminal.")
    return json.loads(credentials.read_text())["workspaces"]


def main(args):
    if not args or args == ["--help"] or args == ["-h"]:
        print(HELP)
        return
    home = Path.home()
    config_dir = home / ".config" / "slackcli"
    routes_file = config_dir / "directory-workspaces.json"
    explicit = None
    if args[0] == "--workspace":
        if len(args) < 3:
            raise ValueError("--workspace requires an organization and command.")
        explicit, args = args[1], args[2:]
    elif args[0].startswith("--workspace="):
        explicit, args = args[0].split("=", 1)[1], args[1:]
    if not args:
        raise ValueError("A command is required.")
    if any(arg == "--workspace" or arg.startswith("--workspace=") for arg in args):
        raise ValueError("Pass --workspace before the command; use organization aliases only.")
    if args[:2] == ["team", "info"] and any(arg == "--team" or arg.startswith("--team=") for arg in args[2:]):
        raise ValueError("team info must check the bound workspace; --team overrides are not allowed.")
    routes = json.loads(routes_file.read_text()) if routes_file.exists() else {}
    if args[0] == "bind":
        if explicit or len(args) != 3 or args[1] not in ORG_NAMES:
            raise ValueError("Usage: bind wearedevs|wollzelle PROFILE_KEY")
        profile = load_profiles(config_dir).get(args[2])
        if not profile:
            raise ValueError("Unknown profile key. Run slackcli auth list.")
        if profile.get("auth_type") != "browser":
            raise ValueError("Drafts require browser authentication; run slackcli auth login-auto.")
        routes[args[1]] = {"profile": args[2], "team_id": profile["workspace_id"]}
        routes_file.write_text(json.dumps(routes, indent=2) + "\n")
        routes_file.chmod(0o600)
        print(f"Bound {args[1]} to {profile['workspace_name']} ({profile['workspace_id']}).")
        return
    org = organization(Path.cwd(), home, explicit)
    route = routes.get(org)
    if not route:
        raise ValueError(f"No binding for {org}. Run: slack-assistant bind {org} PROFILE_KEY")
    if args[0] == "draft":
        args = ["messages", "draft", *args[1:]]
    if args[0] == "send-approved":
        args = ["messages", "send", *args[1:]]
    elif args != ["context"] and tuple(args[:2]) not in ALLOWED:
        raise ValueError("Command not allowed. Use reads/drafts, or send-approved after user approval.")
    profile = load_profiles(config_dir).get(route["profile"])
    if not profile or profile["workspace_id"] != route["team_id"]:
        raise ValueError("Workspace binding no longer matches the stored profile. Re-bind explicitly.")
    print(f"Slack: {org} / {profile['workspace_name']} ({route['team_id']})", file=sys.stderr)
    if args == ["context"]:
        return
    os.execvp("slackcli", ["slackcli", *args, "--workspace", route["profile"]])


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (json.JSONDecodeError, OSError, KeyError):
        # Never dump credential records or tracebacks on configuration failures.
        print("Slack configuration unavailable or invalid. Check login and bindings.", file=sys.stderr)
        sys.exit(1)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
